# ===== Agente de Segurança — configuração =====
# Copie para .env e preencha. NÃO versione o .env.

# Repositório analisado pela API/webhook (padrão: diretório atual)
SECURITY_AGENT_REPO_PATH=..
# Onde salvar os relatórios (padrão: <repo>/relatorios-seguranca)
SECURITY_AGENT_REPORTS_DIR=

# Token exigido nas rotas da API: Authorization: Bearer <token>
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECURITY_AGENT_TOKEN=

# Segredo configurado no webhook do GitHub (Settings > Webhooks > Secret)
GITHUB_WEBHOOK_SECRET=
# true = executa "git pull --ff-only" antes de analisar um push recebido pelo webhook
SECURITY_AGENT_AUTO_PULL=false

# ===== LLM (ChatGPT / API compatível com OpenAI) =====
# Sem chave, o agente funciona apenas com as regras determinísticas.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=60000
# Limites de custo
LLM_MAX_ARQUIVOS=15
LLM_MAX_CARACTERES=24000
LLM_CONCORRENCIA=3

# Servidor autônomo (npm run servidor)
PORT=4010
HOST=127.0.0.1
